# Financial Modeling Prep API key (server-only). Get one at
# https://site.financialmodelingprep.com/developer/docs
# Without a key the app runs in DEMO mode with simulated data.
FMP_API_KEY=

# Private beta gate. Comma- or newline-separated invite codes, optionally labelled:
#   BETA_INVITE_CODES=owner:IEP-XXXX-XXXX-XXXX,tester1:IEP-YYYY-YYYY-YYYY
# Removing a code revokes everyone who entered with it. With the gate on and no
# codes set, nobody can get in (fail closed).
BETA_INVITE_CODES=

# Set to "off" to disable the gate (e.g. local development or public launch).
BETA_GATE=

# Postgres (Neon). The Vercel integration creates STORAGE_DATABASE_URL; DATABASE_URL also works.
# Migrations and the SEC securities load run before each build (scripts/db-setup.ts).
STORAGE_DATABASE_URL=

# Redis (Upstash) for rate limiting and the daily FMP call counter. Optional:
# without it both are disabled. KV_REST_API_* or UPSTASH_REDIS_REST_* names are accepted.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Daily FMP call budget used for the 80 % / 100 % warnings (FMP free plan: 250).
FMP_DAILY_LIMIT=

# Secret Vercel Cron sends to /api/cron/* (Authorization: Bearer ...).
CRON_SECRET=

# The SEC asks every client to identify itself, ideally with a contact email:
#   SEC_USER_AGENT="IEP Analytics tu-email@dominio.com"
SEC_USER_AGENT=
