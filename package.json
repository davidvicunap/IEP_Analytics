{
  "name": "iep-analytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/db-setup.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "start:demo": "BETA_GATE=off DEMO_MODE=1 next start -p 3123",
    "e2e": "node e2e/journeys.mjs http://localhost:3123",
    "e2e:audit": "node e2e/audit.mjs http://localhost:3123 .e2e/audit --shots",
    "e2e:measure": "node e2e/measure.mjs http://localhost:3123 .e2e/measure.json 5",
    "e2e:interactions": "node e2e/interactions.mjs http://localhost:3123"
  },
  "browserslist": [
    "defaults",
    "iOS >= 15",
    "Safari >= 15"
  ],
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "5.11.2",
    "geist": "^1.9.2",
    "lightweight-charts": "^5.2.1",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.10.3",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
